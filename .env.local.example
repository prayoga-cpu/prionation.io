# Copy to .env.local and fill in real values. Never commit .env.local.

# Notion
NOTION_API_KEY=
NOTION_DB_INTAKE=
NOTION_DB_BOOKINGS=
NOTION_DB_CAREERS=
NOTION_DB_WAITLIST=
NOTION_DB_SALES_PIPELINE=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FOUNDER_EMAIL=
RESEND_NOTIFY_EMAILS=          # comma-separated: a@x.com,b@x.com

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supabase Storage (CV uploads)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Discord (form submission notifications)
DISCORD_WEBHOOK_URL=

# App
PRIONATION_ENV=development     # set to "production" on Vercel

# Security toggle (set both to "false" to disable Turnstile + rate limiting)
SECURITY_ENABLED=true
NEXT_PUBLIC_SECURITY_ENABLED=true

# Meta Pixel (optional)
NEXT_PUBLIC_META_PIXEL_ID=

# Google PageSpeed Insights API (npm run pagespeed)
PSI_API_KEY=

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA4_ID=

# Anthropic (AI Consultation — server-only, never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=

# Internal Finance Dashboard (/finance — founder + CRO only)
# See finance_dashboard_dev_plan.md for setup steps.
NOTION_TOKEN=                      # NEW read-only integration, separate from NOTION_API_KEY
FINANCE_DB_TRANSACTIONS=
FINANCE_DB_TRANSACTIONS_DS=
FINANCE_DB_BUDGET=
FINANCE_DB_BUDGET_DS=
FINANCE_DB_SHARES=
FINANCE_DB_SHARES_DS=
FINANCE_DB_PIPELINE=
FINANCE_DB_PIPELINE_DS=
NOTION_ACK_TOKEN=                  # separate write-only integration, Acknowledgments DB only
FINANCE_DB_ACKNOWLEDGMENTS=
FINANCE_DB_ACKNOWLEDGMENTS_DS=     # needed to read acknowledgment history back, not just write
FINANCE_EMAIL_CEO=
FINANCE_EMAIL_CRO=
FINANCE_JWT_SECRET=                # openssl rand -hex 32
