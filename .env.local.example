# Notion
NOTION_API_KEY=
NOTION_DB_INTAKE=
NOTION_DB_BOOKINGS=
NOTION_DB_CAREERS=
NOTION_DB_WAITLIST=
NOTION_DB_SALES_PIPELINE=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FOUNDER_EMAIL=
RESEND_NOTIFY_EMAILS=          # comma-separated: a@x.com,b@x.com

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supabase Storage (CV uploads)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Discord (form submission notifications — redacted, no PII)
DISCORD_WEBHOOK_URL=

# Analytics (client-side; set in Vercel env for production)
NEXT_PUBLIC_GA4_ID=            # GA4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=     # Meta Pixel ID (optional)

# Google PageSpeed Insights API (npm run pagespeed)
PSI_API_KEY=

# Anthropic (AI Consultation — server-only, never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=

# App
PRIONATION_ENV=development     # set to "production" on Vercel

# Security toggle (set both to "false" to disable Turnstile + rate limiting)
SECURITY_ENABLED=true
NEXT_PUBLIC_SECURITY_ENABLED=true
